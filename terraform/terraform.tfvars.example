# Summary: Example Terraform variables for deploying the AWS infrastructure with cost allocation tags.

# AWS Configuration
aws_region = "eu-west-1"

# Project Configuration
project_name = "london-events"
environment  = "prod"
owner        = "will"
cost_center  = "personal-projects"

# OpenAI Configuration
model_name       = "gpt-5"
reasoning_effort = "medium" # Options: minimal, low, medium, high, xhigh

# Email Configuration (must be verified in SES)
ses_from_email = "londoneventsaisummary@gmail.com"
ses_to_email   = "butler.will1@gmail.com"

# Scheduling (EventBridge cron format: minute hour day-of-month month day-of-week year)
# Examples:
#   "cron(0 9 * * ? *)"   - 9 AM UTC daily
#   "cron(0 18 * * ? *)"  - 6 PM UTC daily
#   "cron(0 0 * * ? *)"   - Midnight UTC daily
#   "cron(0 9 ? * 1 *)"   - 9 AM UTC every Sunday
#   "cron(0 9 ? * MON *)" - 9 AM UTC every Monday
schedule_expression = "cron(0 9 ? * 1 *)" # 9 AM UTC every Sunday

# Resource Sizing (adjust based on your needs)
task_cpu    = "2048" # 2 vCPU (increased for Weaviate 1.27.5)
task_memory = "4096" # 4 GB (increased for Weaviate 1.27.5)

weaviate_cpu    = 1024 # 1 vCPU (increased for v1.27.5 startup)
weaviate_memory = 2048 # 2 GB (increased for v1.27.5 startup)

event_finder_cpu    = 512  # 0.5 vCPU
event_finder_memory = 1024 # 1 GB

# Additional reporting tags
tags = {
  Repository = "ai_agent"
}
